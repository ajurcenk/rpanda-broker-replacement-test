# =============================================================================
# runbook.env - settings for the production broker replacement scripts
# =============================================================================
# Edit this file ONCE before starting. Every step script reads it.
# Secrets (SASL password) are NOT stored here: export them in your shell:
#
#     export RB_SASL_USER='admin'
#     read -rs RB_SASL_PASSWORD && export RB_SASL_PASSWORD
#
# Values marked CHANGE-ME must be filled in.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. How rpk and curl reach the cluster (from the bastion host)
# -----------------------------------------------------------------------------
# Kafka bootstrap. Use the repointable DNS names (the same ones clients use).
export RPK_BROKERS="b1.kafka.example.com:9092,b2.kafka.example.com:9092,b3.kafka.example.com:9092,b4.kafka.example.com:9092,b5.kafka.example.com:9092"   # CHANGE-ME

# Admin API entry points (port 9644). Same DNS names. The scripts skip any entry
# that answers without an elected controller (e.g. a broker that was just decommissioned).
export RPK_ADMIN_HOSTS="b1.kafka.example.com:9644,b2.kafka.example.com:9644,b3.kafka.example.com:9644,b4.kafka.example.com:9644,b5.kafka.example.com:9644"   # CHANGE-ME
ADMIN_PORT=9644

# TLS for the Kafka API and the Admin API.
export RPK_TLS_ENABLED=true
export RPK_TLS_CA="/etc/redpanda/certs/ca.crt"          # CHANGE-ME: CA bundle that signed the broker certs
export RPK_ADMIN_TLS_ENABLED=true
export RPK_ADMIN_TLS_CA="$RPK_TLS_CA"

# SASL/SCRAM. User and password come from your shell (see the top of this file).
export RPK_SASL_MECHANISM="SCRAM-SHA-512"               # or SCRAM-SHA-256
export RPK_USER="${RB_SASL_USER:-}"
export RPK_PASS="${RB_SASL_PASSWORD:-}"

# The Admin API uses HTTP basic auth with the same SCRAM user when
# admin_api_require_auth=true. Leave as is unless you use a different user.
ADMIN_USER="${RB_ADMIN_USER:-${RB_SASL_USER:-}}"
ADMIN_PASSWORD="${RB_ADMIN_PASSWORD:-${RB_SASL_PASSWORD:-}}"

# -----------------------------------------------------------------------------
# 2. What the cluster must look like
# -----------------------------------------------------------------------------
EXPECTED_VERSION="v25.3.17"            # every broker, old and new. Never 25.3.16.
RACKS=(eu-central-1a eu-central-1b eu-central-1c)
EXPECTED_BROKER_COUNT=5

# Seed DNS names: exactly one per AZ, in the same form as in redpanda.yaml (Path A).
SEED_DNS_NAMES=(b1.kafka.example.com b3.kafka.example.com b5.kafka.example.com)   # CHANGE-ME
SEED_RPC_PORT=33145
# Maximum acceptable TTL (seconds) on the repointable names.
MAX_DNS_TTL=60

# Topics that must have Tiered Storage enabled (comma separated, regex allowed).
IMPORTANT_TOPICS_REGEX='^order\.'                        # CHANGE-ME

# -----------------------------------------------------------------------------
# 3. The swap plan (Path A). One line per swap, in execution order.
#    DNS_NAME = the repointable name that today points at OLD_HOST.
#    OLD_HOST / NEW_HOST = the brokers' own advertised host names
#    (as shown by `rpk redpanda admin brokers list`, column HOST).
#    NEW_IP  = private IP of the new instance, used to create NEW_HOST's A record if it
#              does not exist yet (step_12). Use "-" if the record is created elsewhere.
#
#    Clients connect to EVERY broker by its advertised name (from the metadata they get via
#    the bootstrap names), so NEW_HOST must resolve and be reachable from all client networks
#    BEFORE the new broker joins. Moving DNS_NAME happens much later (step_18).
# -----------------------------------------------------------------------------
#            DNS_NAME               OLD_HOST                        NEW_HOST                        RACK            NEW_IP
SWAP_PLAN=(
  "b2.kafka.example.com  b2-old.kafka.internal.example.com  n2.kafka.internal.example.com  eu-central-1a  10.0.1.21"   # CHANGE-ME
  "b4.kafka.example.com  b4-old.kafka.internal.example.com  n4.kafka.internal.example.com  eu-central-1b  10.0.2.24"
  "b1.kafka.example.com  b1-old.kafka.internal.example.com  n1.kafka.internal.example.com  eu-central-1a  10.0.1.11"
  "b3.kafka.example.com  b3-old.kafka.internal.example.com  n3.kafka.internal.example.com  eu-central-1b  10.0.2.13"
  "b5.kafka.example.com  b5-old.kafka.internal.example.com  n5.kafka.internal.example.com  eu-central-1c  10.0.3.15"
)

# -----------------------------------------------------------------------------
# 4. Route 53 (step_18)
# -----------------------------------------------------------------------------
ROUTE53_HOSTED_ZONE_ID="Z0000000000000000000"           # CHANGE-ME
DNS_RECORD_TYPE="A"                                     # A (value = new broker IP) or CNAME (value = NEW_HOST)
DNS_TTL=60
# export AWS_PROFILE=...                                # if the bastion needs a specific AWS profile

# Instance names of the NEW brokers (NEW_HOST, step_12). Their A records may live in another
# hosted zone (e.g. a private zone). Set CREATE_INSTANCE_RECORDS=false if your provisioning
# (Terraform, etc.) creates them; the script then only verifies.
INSTANCE_HOSTED_ZONE_ID="$ROUTE53_HOSTED_ZONE_ID"         # CHANGE-ME if different
CREATE_INSTANCE_RECORDS=true
INSTANCE_DNS_TTL=300

# -----------------------------------------------------------------------------
# 5. Fast commission (step_04). Size and/or time target for new replicas.
#    Set the time target above normal consumer lag.
# -----------------------------------------------------------------------------
FC_TARGET_MS=3600000                                    # 1 hour of data copied locally to a new replica
FC_TARGET_BYTES=""                                      # optional size cap, e.g. 1073741824 (1 GiB); empty = unset
# Optional per-topic overrides for replay-heavy topics: "topic=ms"
FC_TOPIC_OVERRIDES=()

# -----------------------------------------------------------------------------
# 6. Recovery rate (step_11 / step_17) and balancer throttle
# -----------------------------------------------------------------------------
RAISED_RECOVERY_RATE=209715200                          # 200 MiB/s, only when you choose to raise it
ROLLBACK_P99_RATIO=2                                    # auto-restore if client p99 > 2x baseline ...
ROLLBACK_SAMPLES=3                                      # ... for 3 consecutive 10 s samples
TEMP_CONCURRENT_MOVES=""                                # optional lower partition_autobalancing_concurrent_moves (step_02)

# -----------------------------------------------------------------------------
# 7. Test clients (step_00). Small, dedicated topics; they never touch business topics.
# -----------------------------------------------------------------------------
TEST_TOPIC_SEQ="rb.test.sequencer"                      # 1 partition: strict ordering check
TEST_TOPIC_LOAD="rb.test.load"                          # 6 partitions: background load
TEST_TOPIC_RETENTION_MS=172800000                       # 2 days, then the data deletes itself
TEST_SEQ_RATE=50                                        # sequenced messages per second
TEST_LOAD_RATE=200                                      # load messages per second (1 KiB each)
TEST_PRELOAD_MB=200                                     # data written to the load topic before starting
TEST_CONSUMER_GROUP="rb-verifier"

# -----------------------------------------------------------------------------
# 8. Timing
# -----------------------------------------------------------------------------
SETTLE_TIMEOUT_MIN=240                                  # step_14 gives up after this long
DECOM_TIMEOUT_MIN=480                                   # step_15 gives up after this long
SOAK_CHECK_MIN=30                                       # step_20 watch window (the runbook soak is 24 h)
POLL_SEC=15

# Commands shown to the operator for the actions done ON the broker hosts.
# {NEW} / {OLD} are replaced with NEW_HOST / OLD_HOST of the swap.
START_NEW_BROKER_HINT="on {NEW}: sudo systemctl start redpanda"
STOP_OLD_BROKER_HINT="on {OLD}: sudo systemctl stop redpanda, then terminate the EC2 instance"

# Where state (saved values, per-swap progress) and logs are kept.
RB_STATE_DIR="${RB_STATE_DIR:-$(dirname "${BASH_SOURCE[0]}")/state}"
RB_LOG_DIR="${RB_LOG_DIR:-$(dirname "${BASH_SOURCE[0]}")/logs}"
