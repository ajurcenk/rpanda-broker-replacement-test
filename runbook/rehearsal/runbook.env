# =============================================================================
# rehearsal/runbook.env - settings for rehearsing against the Docker test harness
# =============================================================================
# Mounted over /runbook/runbook.env INSIDE the bastion container only (rehearsal/bastion.sh).
# The real runbook.env on disk is never changed.
#
# Differences from production: plaintext (no TLS, no SASL), harness DNS names (*.rp.test),
# 5 s DNS TTL, short soak. Route 53 calls go to rehearsal/aws, which edits the harness
# CoreDNS zone file (coredns/rp.test.hosts).
# =============================================================================

# ---- 1. Cluster access (harness: plaintext) ----
export RPK_BROKERS="b1.rp.test:9092,b2.rp.test:9092,b3.rp.test:9092,b4.rp.test:9092,b5.rp.test:9092"
export RPK_ADMIN_HOSTS="b1.rp.test:9644,b2.rp.test:9644,b3.rp.test:9644,b4.rp.test:9644,b5.rp.test:9644"
ADMIN_PORT=9644
export RPK_TLS_ENABLED=false
export RPK_ADMIN_TLS_ENABLED=false
export RPK_TLS_CA=""
export RPK_ADMIN_TLS_CA=""
export RPK_SASL_MECHANISM=""
export RPK_USER=""
export RPK_PASS=""
ADMIN_USER=""
ADMIN_PASSWORD=""

# ---- 2. Expected cluster shape ----
EXPECTED_VERSION="v25.3.17"
RACKS=(eu-central-1a eu-central-1b eu-central-1c)
EXPECTED_BROKER_COUNT=5
SEED_DNS_NAMES=(b1.rp.test b3.rp.test b5.rp.test)
SEED_RPC_PORT=33145
MAX_DNS_TTL=60
IMPORTANT_TOPICS_REGEX='^order\.'

# ---- 3. Swap plan ----
# Pick a swap that fits the harness as it is NOW. See which broker each alias points at with:
#     grep alias ../coredns/rp.test.hosts
# OLD_HOST = the instance behind DNS_NAME today; NEW_HOST = an instance in the SAME rack that is
# not running yet (docker ps --format '{{.Names}}' | grep rp-).
# On a FRESH cluster (scripts/up.sh): b1..b5 -> io-b1..io-b5, replacements nv-n1..nv-n5:
#     b1 io-b1 -> nv-n1 eu-central-1a 172.30.0.21     b2 io-b2 -> nv-n2 eu-central-1a 172.30.0.22
#     b3 io-b3 -> nv-n3 eu-central-1b 172.30.0.23     b4 io-b4 -> nv-n4 eu-central-1b 172.30.0.24
#     b5 io-b5 -> nv-n5 eu-central-1c 172.30.0.25
# Spare instances after earlier rehearsals: sp-1 (.61), tmp-1 (.31) in 1a; sp-2 (.62) in 1b; sp-3 (.63) in 1c.
# "Start Redpanda on the new host" = ../scripts/broker.sh start <instance>   (run on the laptop)
# "Terminate the old instance"     = ../scripts/broker.sh rm <instance>
#            DNS_NAME     OLD_HOST        NEW_HOST       RACK           NEW_IP
SWAP_PLAN=(
  "b2.rp.test  io-b2.rp.test  nv-n2.rp.test  eu-central-1a  172.30.0.22"
)

# ---- 4. "Route 53" (rehearsal/aws edits the CoreDNS zone; zone IDs are ignored) ----
ROUTE53_HOSTED_ZONE_ID="ZREHEARSAL"
DNS_RECORD_TYPE="A"
DNS_TTL=5
INSTANCE_HOSTED_ZONE_ID="ZREHEARSAL"
CREATE_INSTANCE_RECORDS=true
INSTANCE_DNS_TTL=5

# ---- 5. Fast commission ----
FC_TARGET_MS=60000
FC_TARGET_BYTES=""
FC_TOPIC_OVERRIDES=()

# ---- 6. Recovery rate ----
RAISED_RECOVERY_RATE=209715200
ROLLBACK_P99_RATIO=2
ROLLBACK_SAMPLES=3
TEMP_CONCURRENT_MOVES=""

# ---- 7. Test clients ----
TEST_TOPIC_SEQ="rb.test.sequencer"
TEST_TOPIC_LOAD="rb.test.load"
TEST_TOPIC_RETENTION_MS=172800000
TEST_SEQ_RATE=50
TEST_LOAD_RATE=200
TEST_PRELOAD_MB=20
TEST_CONSUMER_GROUP="rb-verifier"

# ---- 8. Timing ----
SETTLE_TIMEOUT_MIN=60
DECOM_TIMEOUT_MIN=60
SOAK_CHECK_MIN=2
POLL_SEC=10

# Host actions in the rehearsal = harness commands, run on the LAPTOP in a second terminal.
# {NEW}/{OLD} become e.g. nv-n2.rp.test; the harness wants the instance name without .rp.test.
START_NEW_BROKER_HINT="on the laptop, in broker-replaceent-test/: scripts/broker.sh start {NEW%.rp.test}"
STOP_OLD_BROKER_HINT="on the laptop, in broker-replaceent-test/: scripts/broker.sh rm {OLD%.rp.test}"

# State and logs of the rehearsal stay in rehearsal/ (set by bastion.sh), never in runbook/state.
RB_STATE_DIR="${RB_STATE_DIR:-/rehearsal/state}"
RB_LOG_DIR="${RB_LOG_DIR:-/rehearsal/logs}"
